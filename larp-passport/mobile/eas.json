{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "pirate" }
    },
    "preview-hunt": {
      "extends": "preview",
      "env": { "APP_VARIANT": "hunt" }
    },
    "production": {
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "pirate" }
    },
    "production-hunt": {
      "extends": "production",
      "env": { "APP_VARIANT": "hunt" }
    }
  }
}
